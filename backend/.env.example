# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual credentials: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/iot_monitoring?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://student_admin:your_secure_password@cluster0.mongodb.net/iot_monitoring?retryWrites=true&w=majority

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# Simulation Configuration Defaults
SIMULATION_INTERVAL_MS=3000
DISCONNECT_TIMEOUT_SEC=15
